# Copy to .env and fill in what you need. Nothing here is required except one script writer
# (Groq key OR a running Ollama). Never commit .env.

# ---- Script writer (providers are tried in order; the next one is used if a call fails) ----
LLM_PROVIDERS=groq,ollama
GROQ_API_KEY=                          # free key: https://console.groq.com
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b   # each model has its own free limits
GROQ_REASONING=low                     # low | medium | high
OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b              # default: best installed model
# OPENAI_API_KEY=                      # optional; any OpenAI-compatible API (set OPENAI_BASE_URL too)
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o-mini

# ---- Stock footage ----
PIXABAY_API_KEY=                       # free: https://pixabay.com/api/docs/

# ---- YouTube research & stats (read-only) ----
# Either a plain API key with "YouTube Data API v3" enabled ...
# YOUTUBE_API_KEY=
# ... or a Google service-account key file placed in credentials/
GOOGLE_APPLICATION_CREDENTIALS=credentials/service-account.json

# ---- Voice ----
# TTS_VOICE=en-US-AriaNeural           # overrides the per-language default

# ---- Publishing (optional; nothing publishes without your approval) ----
# YOUTUBE_CLIENT_SECRETS=credentials/client_secret.json
# YOUTUBE_TOKEN_FILE=credentials/youtube_token.json
# MEDIA_PUBLIC_BASE_URL=https://your-public-host   # Instagram must fetch the MP4 over public HTTPS
# INSTAGRAM_USER_ID=
# INSTAGRAM_ACCESS_TOKEN=
# META_GRAPH_VERSION=v23.0

# ---- Optional paid AI video: Kling (https://klingai.com -> developer console -> API keys) ----
# KLING_ACCESS_KEY=
# KLING_SECRET_KEY=
# KLING_BASE_URL=https://api.klingai.com      # some accounts use https://api-singapore.klingai.com
# KLING_MODEL=kling-v1-6
# KLING_MODE=std                              # std | pro (pro costs more units per clip)
# KLING_DURATION=5                            # 5 | 10 seconds
# KLING_MAX_CLIPS_PER_VIDEO=4                 # spend guard: scenes beyond this fall back to LTX / stock
# KLING_DAILY_CLIP_LIMIT=12                   # spend guard across all videos, per day
# KLING_TIMEOUT_MIN=15

# ---- Optional AI video via Apiframe credits (https://console.apiframe.ai -> API keys; ~100 free credits on signup) ----
# APIFRAME_API_KEY=
# APIFRAME_MODEL=seedance-1-pro-fast          # any seedance-* or kling-* model; see https://apiframe.ai/docs/pricing
# APIFRAME_RESOLUTION=720p                    # 480p | 720p | 1080p (Seedance only; 720p 5 s = 16 credits)
# APIFRAME_DURATION=5                         # 5 | 10 seconds
# APIFRAME_MAX_CLIPS_PER_VIDEO=3              # spend guard: scenes beyond this fall back to LTX / stock
# APIFRAME_DAILY_CLIP_LIMIT=6                 # spend guard across all videos, per day
# APIFRAME_TIMEOUT_MIN=15
# SLOWMO_MAX=2.0                              # single-shot videos: how much a fast-motion AI clip may be slowed to fill the video

# ---- Optional local AI video (LTX-Video 2B) ----
# LTX_MODEL_DIR=models/LTX-Video
# LTX_WIDTH=480
# LTX_HEIGHT=864
# LTX_FRAMES=49                        # 8k+1; 49 is about 2 seconds
# LTX_STEPS=30
# LTX_GUIDANCE=4.0
# LTX_TIMEOUT_MIN=120

# ---- Instagram downloader (Download tab) - needs `brew install yt-dlp`; run `brew upgrade yt-dlp` if downloads start failing ----
# INSTAGRAM_COOKIES_BROWSER=chrome            # optional: use this browser's Instagram login when a post asks for one (chrome|firefox|safari|edge)
